# App Security
SECRET_KEY=your-super-secret-random-string-here
ALGORITHM=HS256

# Database Configuration
# Local development (default):
DATABASE_URL=sqlite:///./appointments.db
# Production on Vercel (use Neon, Supabase, or Vercel Postgres):
# DATABASE_URL=postgresql://user:password@host:5432/dbname?sslmode=require

# AI Configuration
# Local development (requires Ollama running):
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=gemma4
# Production (use a publicly reachable Ollama instance or compatible API):
# OLLAMA_BASE_URL=https://your-ollama-host.example.com
